generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
  DELIVERY
  CUSTOMER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WhatsappProvider {
  INTERAKT
  AISENSY
  GUPSHUP
  TWILIO
}

enum EmailProvider {
  RESEND
  SMTP
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationRecipientType {
  CUSTOMER
  OWNER
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponDiscountType {
  PERCENTAGE
  FLAT
}

enum MealWeightUnit {
  G
  KG
}

enum PromotionType {
  BOGO
  FREE_ITEM_ON_MINIMUM
  SCHEDULED_DISCOUNT
  // Subscription-plan equivalent of BOGO — grants bonusDays on the same
  // plan/subscription rather than a free cart item (§11 of the plan doc:
  // BOGO's "free item" has no meaning for a subscription).
  PLAN_BONUS_DAYS
}

/**
 * Which surface a Coupon/Promotion is redeemable on — order checkout, plan
 * signup, or both. Default ORDERS everywhere so nothing existing changes
 * behavior; PLANS/BOTH are opt-in per coupon/promotion.
 */
enum PromoAppliesTo {
  ORDERS
  PLANS
  BOTH
}

enum SubscriptionPlanType {
  CURATED
  CUSTOM
}

/**
 * Which of the tenant's own semantic theme ramps accents a plan card —
 * never a raw hex, so a brand-color change in Settings reskins every plan
 * card instantly, same rule as every other component in this frontend.
 */
enum PlanAccentColor {
  PRIMARY
  SECONDARY
  ACCENT
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  LINKEDIN
  TWITTER
  WHATSAPP
  PINTEREST
}

enum MealSlotType {
  BREAKFAST
  LUNCH
  DINNER
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PlatformSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PlatformInvoiceStatus {
  PAID
  FAILED
}

// ─── Tenant ──────────────────────────────────────────────

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  plan         Plan     @default(FREE)
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                    User[]
  businessProfile          BusinessProfile?
  orderAcceptanceSettings  OrderAcceptanceSettings?
  notificationSettings     NotificationSettings?
  paymentSettings          PaymentSettings?
  serviceablePincodes      ServiceablePincode[]
  rolePermissions          RolePermission[]
  tenantFeatures           TenantFeature[]
  categories               Category[]
  meals                    Meal[]
  addresses                Address[]
  orders                   Order[]
  deliverySlots            DeliverySlot[]
  notificationLogs         NotificationLog[]
  coupons                  Coupon[]
  couponRedemptions        CouponRedemption[]
  planCouponRedemptions    PlanCouponRedemption[]
  promotions               Promotion[]
  subscriptionPlans        SubscriptionPlan[]
  subscriptions            Subscription[]
  subscriptionInvoices     SubscriptionInvoice[]
  subscriptionSettings     SubscriptionSettings?
  instantDeliverySettings  InstantDeliverySettings?
  staticPages              StaticPage[]
  platformTermsAcceptances PlatformTermsAcceptance[]
  platformSubscription     PlatformSubscription?
  activationInvites        TenantActivationInvite[]
  platformInvoices         PlatformInvoice[]
  tenantLimits             TenantLimits?
  platformLeads            PlatformLead[]
  homeSections             HomeSection[]
  reviews                  Review[]
  socialLinks              SocialLink[]
  homePageContent          HomePageContent?
  planFeatures             PlanFeature[]
  planFaqs                 PlanFaq[]

  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?
  passwordHash    String
  firstName       String
  lastName        String?
  role            Role      @default(CUSTOMER)
  status          Status    @default(ACTIVE)
  tenantId        String
  isActive        Boolean   @default(true)
  verifiedAt      DateTime?
  termsAcceptedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  refreshTokens            RefreshToken[]
  addresses                Address[]
  orders                   Order[]
  subscriptions            Subscription[]
  platformTermsAcceptances PlatformTermsAcceptance[]

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("users")
}

// ─── Business configuration (white-label, per tenant) ────

model BusinessProfile {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  displayName               String
  description               String?
  logoUrl                   String?
  faviconUrl                String?
  heroImageUrl              String?
  supportEmail              String?
  supportPhone              String?
  whatsappBusinessNumber    String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  state                     String?
  country                   String?
  pincode                   String?
  timezone                  String   @default("Asia/Kolkata")
  currency                  String   @default("INR")
  gstNumber                 String?
  themeConfig               Json     @default("{}")
  defaultLocale             String   @default("en")
  // Geo-radius serviceability (Blinkit-style): when kitchenLat/kitchenLng and
  // deliveryRadiusMeters are all set, AddressesService prefers a real
  // distance-from-kitchen check over the ServiceablePincode table.
  kitchenLat                Float?
  kitchenLng                Float?
  deliveryRadiusMeters      Int?
  deliveryFee               Int?
  minOrderAmount            Int?
  freeDeliveryAboveAmount   Int?
  // How many days ahead a customer may pick for delivery (0 = today only,
  // 2 = today/tomorrow/day-after). Checkout's day dropdown is bounded by
  // this, enforced again server-side in OrdersService.
  maxAdvanceOrderDays       Int      @default(2)
  // Home page testimonials block — only rendered if true AND at least one
  // published Review exists.
  showReviewsOnHomepage     Boolean  @default(false)
  // Google Search Console's HTML-tag verification content (the value of
  // <meta name="google-site-verification" content="...">) — lets a tenant
  // prove domain ownership without needing DNS/file-upload access.
  searchConsoleVerification String?
  // FSSAI (Food Safety and Standards Authority of India) license — a
  // number alone doesn't mean "show this publicly": showFssaiLicense is a
  // separate switch, off by default, so adding the number doesn't
  // immediately publish it to the footer/invoices. The logo itself is one
  // shared static asset (frontend `components/icons/FssaiBadge.tsx`), not
  // per-tenant uploadable — every tenant displaying it uses the same mark.
  fssaiLicenseNumber        String?
  showFssaiLicense          Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("business_profiles")
}

// Footer social icons — one link per platform per tenant, toggled on/off
// independent of whether it's configured (lets an admin park a URL without
// it going live yet).
model SocialLink {
  id        String         @id @default(uuid())
  tenantId  String
  platform  SocialPlatform
  url       String
  isEnabled Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, platform])
  @@index([tenantId])
  @@map("social_links")
}

model OrderAcceptanceSettings {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  operatingHours      Json     @default("{}")
  dailyCutoffTime     String?
  closedDates         Json     @default("[]")
  isTemporarilyClosed Boolean  @default(false)
  closureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("order_acceptance_settings")
}

model ServiceablePincode {
  id                      String   @id @default(uuid())
  tenantId                String
  pincode                 String
  deliveryFee             Int      @default(0)
  minOrderAmount          Int      @default(0)
  freeDeliveryAboveAmount Int?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, pincode])
  @@index([tenantId])
  @@map("serviceable_pincodes")
}

model DeliverySlot {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  orders                   Order[]
  subscriptions            Subscription[]
  subscriptionDayOverrides SubscriptionDayOverride[]

  @@index([tenantId])
  @@map("delivery_slots")
}

model InstantDeliverySettings {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  isEnabled     Boolean  @default(false)
  // The ETA range shown to customers (e.g. "30-45 min") and used to
  // snapshot deliveryWindowStart/End on an instant order at the moment
  // it's placed.
  etaMinMinutes Int      @default(30)
  etaMaxMinutes Int      @default(45)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("instant_delivery_settings")
}

model NotificationSettings {
  id                      String            @id @default(uuid())
  tenantId                String            @unique
  whatsappEnabled         Boolean           @default(false)
  whatsappProvider        WhatsappProvider?
  whatsappApiKeyEncrypted String?
  whatsappConfigEncrypted Json?
  whatsappSenderNumber    String?
  ownerWhatsappNumber     String?
  emailEnabled            Boolean           @default(false)
  emailProvider           EmailProvider?
  emailFromAddress        String?
  emailFromName           String?
  emailConfigEncrypted    Json?
  ownerNotificationEmail  String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("notification_settings")
}

// Audit trail for every order-confirmation send attempt (one row per
// channel × recipient, whether it succeeded or failed) — debuggability and
// the natural place to check "did the customer actually get notified?".
model NotificationLog {
  id                String                    @id @default(uuid())
  tenantId          String
  orderId           String?
  channel           NotificationChannel
  recipientType     NotificationRecipientType
  recipient         String
  status            String
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime                  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@map("notification_logs")
}

model PaymentSettings {
  id                             String   @id @default(uuid())
  tenantId                       String   @unique
  razorpayKeyId                  String?
  razorpayKeySecretEncrypted     String?
  razorpayWebhookSecretEncrypted String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("payment_settings")
}

// ─── Permissions (fine-grained, tenant-configurable RBAC) ─

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  category    String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  tenantId     String
  role         Role
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, role, permissionId])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("role_permissions")
}

// ─── Feature entitlement (tenant-level, separate from Permission) ─
// Permission (above) answers "can this role do X within a tenant that
// already has the feature?" Feature answers "does this tenant have access
// to X at all?" — SUPER_ADMIN-only, like a SaaS plan tier.

model Feature {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  tenantFeatures TenantFeature[]

  @@map("features")
}

model TenantFeature {
  id              String    @id @default(uuid())
  tenantId        String
  featureId       String
  enabled         Boolean   @default(false)
  enabledAt       DateTime?
  enabledByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([tenantId, featureId])
  @@index([tenantId])
  @@map("tenant_features")
}

// ─── Menu (Category + Meal) ──────────────────────────────

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  meals  Meal[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Meal {
  id                 String    @id @default(uuid())
  tenantId           String
  categoryId         String?
  name               String
  description        String?
  imageUrl           String?
  priceInPaise       Int
  nutrition          Json      @default("{}")
  isVegetarian       Boolean   @default(true)
  isAvailable        Boolean   @default(true)
  // Admin-curated "Popular" flag — mirrors SubscriptionPlan.isPopular. Drives
  // a storefront badge and the menu page's Popular filter; not computed from
  // real order analytics.
  isPopular          Boolean   @default(false)
  // Both null unless the admin explicitly sets a weight — the menu card
  // only shows a weight badge when both are present.
  weightValue        Float?
  weightUnit         MealWeightUnit?
  dailyQuantityLimit Int?
  sortOrder          Int       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id])
  orderItems            OrderItem[]
  promotionsAsBuyMeal   Promotion[]            @relation("PromotionBuyMeal")
  promotionsAsGetMeal   Promotion[]            @relation("PromotionGetMeal")
  promotionsAsFreeMeal  Promotion[]            @relation("PromotionFreeMeal")
  subscriptionPlanSlots SubscriptionPlanSlot[]
  homeSectionItems      HomeSectionItem[]

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isAvailable])
  @@index([deletedAt])
  @@map("meals")
}

// Admin-curated storefront home page sections (e.g. "Today's Special",
// "Best Sellers") — custom-named, manually populated with products. A meal
// may appear in multiple sections at once (normal merchandising); deleting
// a section cascades to its items.
model HomeSection {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  items  HomeSectionItem[]

  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@map("home_sections")
}

model HomeSectionItem {
  id        String   @id @default(uuid())
  sectionId String
  mealId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  section HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  meal    Meal        @relation(fields: [mealId], references: [id])

  @@unique([sectionId, mealId])
  @@index([sectionId])
  @@map("home_section_items")
}

// Admin-curated testimonials — not customer-submitted (confirmed with
// Arpit: simplest path since the platform has few organic reviews yet).
model Review {
  id          String   @id @default(uuid())
  tenantId    String
  authorName  String
  avatarUrl   String?
  role        String?
  rating      Int
  comment     String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@map("reviews")
}

// Home page hero + CTA + reviews-section copy — one row per tenant, edited
// from /admin/home. All fields nullable so an unconfigured tenant falls
// back to the frontend's own hardcoded defaults, byte-for-byte unchanged
// from before this model existed.
model HomePageContent {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  heroTagline               String?
  heroTitle                 String?
  heroSubtitle              String?
  heroImageUrls             String[] @default([])
  reviewsSectionTitle       String?
  reviewsSectionDescription String?
  ctaEnabled                Boolean  @default(true)
  ctaTitle                  String?
  ctaDescription            String?
  ctaPrimaryLabel           String?
  ctaPrimaryLink            String?
  ctaSecondaryLabel         String?
  ctaSecondaryLink          String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("home_page_content")
}

// "Why subscribe?" cards on the /plans page — admin-curated, same
// tenant-scoped-list pattern as HomeSection/Review.
model PlanFeature {
  id          String   @id @default(uuid())
  tenantId    String
  icon        String
  title       String
  description String?
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@map("plan_features")
}

// FAQ accordion on the /plans page.
model PlanFaq {
  id          String   @id @default(uuid())
  tenantId    String
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@map("plan_faqs")
}

// ─── Addresses & Commerce ─────────────────────────────────

model Address {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  label        String?
  contactPhone String
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  landmark     String?
  // Captured from the map picker at address-creation time; null for
  // addresses saved before that existed, or for tenants without the geo
  // serviceability mode configured. AddressesService falls back to pincode
  // matching whenever either is missing.
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  user          User                      @relation(fields: [userId], references: [id])
  orders        Order[]
  subscriptions Subscription[]
  dayOverrides  SubscriptionDayOverride[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("addresses")
}

model Order {
  id                  String        @id @default(uuid())
  tenantId            String
  userId              String
  addressId           String
  orderNumber         String
  status              OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus       PaymentStatus @default(PENDING)
  subtotalInPaise     Int
  // Sum of all applied discounts (scheduled promos + BOGO/free-item retail
  // value + coupon), always computed server-side, never trusted from the
  // client. subtotalInPaise already includes any free items at their real
  // retail price, so totalInPaise = subtotalInPaise - discountInPaise +
  // deliveryFeeInPaise.
  discountInPaise     Int           @default(0)
  // Snapshotted like item price/name — a later coupon edit never rewrites
  // past order history.
  couponCode          String?
  deliveryFeeInPaise  Int           @default(0)
  totalInPaise        Int
  // The chosen calendar day, and a snapshot of the slot's name/window at
  // order time — snapshotted like OrderItem's price/name, so a tenant
  // editing DeliverySlot later never rewrites past order history.
  deliveryDate        DateTime
  deliverySlotId      String?
  deliverySlotName    String
  deliveryWindowStart String
  deliveryWindowEnd   String
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?
  notes               String?
  // Set only for a nightly-materialized subscription delivery — lets the
  // admin "Today's Deliveries" view query real Order rows directly instead
  // of pattern-matching the notes text.
  subscriptionId      String?
  // True when placed via the instant-delivery option instead of a picked
  // day/slot — deliverySlotId is null and deliveryWindowStart/End are a
  // snapshot of now + the tenant's configured ETA at order time, not a
  // named DeliverySlot's fixed window.
  isInstant           Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  address          Address           @relation(fields: [addressId], references: [id])
  deliverySlot     DeliverySlot?     @relation(fields: [deliverySlotId], references: [id])
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id])
  items            OrderItem[]
  notificationLogs NotificationLog[]
  couponRedemption CouponRedemption?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  mealId               String?
  nameSnapshot         String
  priceInPaiseSnapshot Int
  quantity             Int
  // Added by a BOGO/free-item-on-minimum promotion — priceInPaiseSnapshot
  // still holds the meal's real price (for an honest "you saved ₹X" line),
  // but its value is excluded from the charged total via Order.discountInPaise.
  isFreeItem           Boolean  @default(false)
  createdAt            DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  meal  Meal? @relation(fields: [mealId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model RazorpayWebhookEvent {
  id           String    @id @default(uuid())
  eventId      String    @unique
  eventType    String
  status       String    @default("PENDING")
  errorMessage String?
  // The raw parsed JSON body, exactly as Razorpay sent it — kept for
  // debugging/audit (e.g. inspecting a real delivery in Prisma Studio)
  // without needing to re-derive it from logs.
  payload      Json?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@map("razorpay_webhook_events")
}

// ─── Promotions & coupons ────────────────────────────────
// Validated and applied server-side only, at order-creation time — a
// client-shown discount is always a preview, never trusted as the charge.

model Coupon {
  id                    String             @id @default(uuid())
  tenantId              String
  code                  String
  discountType          CouponDiscountType
  discountValue         Int
  minOrderAmountInPaise Int                @default(0)
  maxUsesTotal          Int?
  maxUsesPerUser        Int?
  validFrom             DateTime?
  validUntil            DateTime?
  isActive              Boolean            @default(true)
  // Whether this code is redeemable at order checkout, plan signup, or
  // both — usage limits are tracked separately per surface (redemptions vs
  // planRedemptions below), never combined.
  appliesTo             PromoAppliesTo     @default(ORDERS)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  redemptions     CouponRedemption[]
  planRedemptions PlanCouponRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid())
  tenantId  String
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model Promotion {
  id        String         @id @default(uuid())
  tenantId  String
  type      PromotionType
  name      String
  isActive  Boolean        @default(true)
  // Whether this promotion applies to order checkout or plan signup —
  // PLAN_BONUS_DAYS is always effectively PLANS; SCHEDULED_DISCOUNT can be
  // either (a scheduled % off a plan's price, not just a meal's).
  appliesTo PromoAppliesTo @default(ORDERS)

  // BOGO — buy `buyQuantity` of buyMealId, get `getQuantity` of getMealId
  // free (getMealId falls back to buyMealId, i.e. "buy 2 get 1 of the same").
  buyMealId   String?
  buyQuantity Int?
  getMealId   String?
  getQuantity Int?

  // FREE_ITEM_ON_MINIMUM — unlock one freeMealId once cart subtotal (before
  // any discount) crosses minOrderAmountInPaise.
  minOrderAmountInPaise Int?
  freeMealId            String?

  // SCHEDULED_DISCOUNT — discountPercentage off, only during a recurring
  // day-of-week + time window (daysOfWeek: 0=Sun..6=Sat, matching
  // Date#getDay(); empty = every day). Scoped by mealIds/categoryIds unless
  // storewide.
  discountPercentage Int?
  daysOfWeek         Int[]    @default([])
  startTime          String?
  endTime            String?
  mealIds            String[] @default([])
  categoryIds        String[] @default([])
  storewide          Boolean  @default(false)

  // PLAN_BONUS_DAYS — grants bonusDays free on the same subscription once
  // its plan qualifies. planIds empty = every plan (storewide-among-plans,
  // same convention as mealIds/storewide above). minCycleDays is an
  // optional qualifying threshold (e.g. only a 30-day+ plan unlocks it) —
  // the plan-duration equivalent of FREE_ITEM_ON_MINIMUM's subtotal threshold.
  planIds      String[] @default([])
  minCycleDays Int?
  bonusDays    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  buyMeal  Meal?  @relation("PromotionBuyMeal", fields: [buyMealId], references: [id])
  getMeal  Meal?  @relation("PromotionGetMeal", fields: [getMealId], references: [id])
  freeMeal Meal?  @relation("PromotionFreeMeal", fields: [freeMealId], references: [id])

  @@index([tenantId])
  @@index([tenantId, type, isActive])
  @@map("promotions")
}

// ─── Subscription plans (§11 — curated plans only for now, CUSTOM type
// reserved for a later pass) ──────────────────────────────

model SubscriptionPlan {
  id           String               @id @default(uuid())
  tenantId     String
  type         SubscriptionPlanType @default(CURATED)
  name         String
  description  String?
  durationDays Int
  priceInPaise Int
  isActive     Boolean              @default(true)
  // A plan can be published while some SubscriptionPlanSlots are still TBD
  // (mealId null) — lets an OWNER pre-sell before finishing later days.
  isPublished  Boolean              @default(false)
  // Storefront card display — bullet points (e.g. "Free delivery", "Skip or
  // pause anytime"), a highlight badge, and which of the tenant's own
  // semantic theme ramps (never a raw hex) accents the card. Ported from
  // the Nutriwell demo's PlanCard design, adapted to stay theme-safe: the
  // demo hardcoded a Tailwind gradient per plan (`from-emerald-400 ...`),
  // which would break "changing brand colors reskins everything instantly"
  // — accentColor is a ramp choice instead, resolved to real classes by a
  // lookup map on the frontend so Tailwind's JIT scanner can still see them.
  features     String[]             @default([])
  badgeText    String?
  isPopular    Boolean              @default(false)
  accentColor  PlanAccentColor      @default(PRIMARY)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  days          SubscriptionPlanDay[]
  subscriptions Subscription[]

  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@map("subscription_plans")
}

model SubscriptionPlanDay {
  id        String   @id @default(uuid())
  planId    String
  dayNumber Int
  createdAt DateTime @default(now())

  plan  SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  slots SubscriptionPlanSlot[]

  @@unique([planId, dayNumber])
  @@index([planId])
  @@map("subscription_plan_days")
}

model SubscriptionPlanSlot {
  id        String       @id @default(uuid())
  planDayId String
  slotType  MealSlotType
  // Null = OWNER intends a meal here but hasn't decided yet — customer
  // sees "Meal to be announced" instead of a blank/broken slot. A slot row
  // simply not existing for a given day means that day doesn't have that
  // meal at all (e.g. a 1-meal/day day only has a LUNCH row).
  mealId    String?

  planDay SubscriptionPlanDay @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  meal    Meal?               @relation(fields: [mealId], references: [id])

  @@unique([planDayId, slotType])
  @@index([planDayId])
  @@map("subscription_plan_slots")
}

model Subscription {
  id             String             @id @default(uuid())
  tenantId       String
  userId         String
  planId         String
  // Mutable prospectively (changes only affect days not yet materialized);
  // each materialized day's Order.addressId snapshots and becomes
  // immutable from that point — same rule §1 documents for regular orders.
  addressId      String
  // The default slot used every day unless a SubscriptionDayOverride
  // exists for that specific date. Nullable — a tenant with no delivery
  // slots configured still materializes fine, just with no named window.
  deliverySlotId String?
  status         SubscriptionStatus @default(PENDING_PAYMENT)

  // Snapshotted at signup — a later plan price/duration/name edit never
  // retroactively changes an existing subscriber's terms. couponCode and
  // bonusDaysGranted mirror Order.couponCode's own snapshot rule (a later
  // coupon-code rename or promotion edit must never rewrite history), and
  // let the admin subscriber list show what was actually applied without a
  // live join that could drift.
  priceInPaiseSnapshot Int
  durationDaysSnapshot Int
  planNameSnapshot     String
  couponCode           String?
  bonusDaysGranted     Int     @default(0)

  startDate         DateTime?
  // The paid-through date — extended by bankedDays whenever a skip/pause
  // is recorded, never shortened. Materialization only runs while
  // today <= cycleEnd.
  cycleEnd          DateTime?
  // Counts actual materialized days, not calendar days since startDate —
  // skips/pauses shift future template days later without ever repeating
  // a meal. Points at SubscriptionPlanDay.dayNumber for the next delivery.
  nextPlanDayNumber Int       @default(1)
  bankedDays        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant                    @relation(fields: [tenantId], references: [id])
  user               User                      @relation(fields: [userId], references: [id])
  plan               SubscriptionPlan          @relation(fields: [planId], references: [id])
  address            Address                   @relation(fields: [addressId], references: [id])
  deliverySlot       DeliverySlot?             @relation(fields: [deliverySlotId], references: [id])
  skips              SubscriptionSkip[]
  invoices           SubscriptionInvoice[]
  couponRedemption   PlanCouponRedemption?
  dayOverrides       SubscriptionDayOverride[]
  materializedOrders Order[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model SubscriptionSkip {
  id             String   @id @default(uuid())
  subscriptionId String
  // YYYY-MM-DD, tenant-local — same "never round-trip a date range through
  // a Date object" principle as the overview chart's bucket boundaries.
  // dateFrom == dateTo for a single-day skip; a wider range is a pause.
  dateFrom       String
  dateTo         String
  bankedDays     Int
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_skips")
}

/**
 * A per-day exception to the subscription's own default address/slot —
 * customer sets this within SubscriptionSettings.noticeHoursBeforeDelivery
 * of that date; materialization checks here first, falls back to the
 * subscription's own addressId/deliverySlotId when no row exists. Either
 * field can be set independently (change just the address, just the time,
 * or both for one day).
 */
model SubscriptionDayOverride {
  id             String   @id @default(uuid())
  subscriptionId String
  date           String
  addressId      String?
  deliverySlotId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  address      Address?      @relation(fields: [addressId], references: [id])
  deliverySlot DeliverySlot? @relation(fields: [deliverySlotId], references: [id])

  @@unique([subscriptionId, date])
  @@index([subscriptionId])
  @@map("subscription_day_overrides")
}

/**
 * One row per tenant — mirrors OrderAcceptanceSettings' "is this tenant
 * open for business" shape, but deliberately separate: a tenant may want
 * to pause new subscriptions without pausing regular one-off ordering, or
 * vice versa. noticeHoursBeforeDelivery is the single lead-time rule used
 * for three things: skip/pause, day-override edits, and how far out a
 * brand-new subscription's Day 1 gets pushed at signup.
 */
model SubscriptionSettings {
  id                          String   @id @default(uuid())
  tenantId                    String   @unique
  // Master switch — OWNER's own choice to pause the subscriptions program
  // entirely. When false, the storefront hides /plans (nav, footer, home
  // page block) and blocks direct navigation to it; customers who already
  // have a subscription can still manage it from "My Subscriptions".
  isEnabled                   Boolean  @default(true)
  isAcceptingNewSubscriptions Boolean  @default(true)
  closureReason               String?
  noticeHoursBeforeDelivery   Int      @default(24)
  // Home page plans block — only rendered if true AND at least one
  // published SubscriptionPlan exists.
  showOnHomepage              Boolean  @default(true)
  // Home page "Meal Plans" block copy — falls back to the frontend's own
  // hardcoded default when unset.
  homepageTitle               String?
  homepageDescription         String?
  // /plans page's own header band copy.
  plansPageTitle              String?
  plansPageSubtitle           String?
  // Plans-page extra sections, each independently toggleable.
  whySubscribeEnabled         Boolean  @default(true)
  faqEnabled                  Boolean  @default(true)
  contactCtaEnabled           Boolean  @default(true)
  contactCtaTitle             String?
  contactCtaDescription       String?
  // Falls back to BusinessProfile.supportEmail when unset.
  contactEmail                String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("subscription_settings")
}

model SubscriptionInvoice {
  id                String                    @id @default(uuid())
  tenantId          String
  subscriptionId    String
  razorpayOrderId   String                    @unique
  razorpayPaymentId String?
  amountInPaise     Int
  status            SubscriptionInvoiceStatus @default(PENDING)
  cycleStart        DateTime?
  cycleEnd          DateTime?
  createdAt         DateTime                  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("subscription_invoices")
}

model PlanCouponRedemption {
  id             String   @id @default(uuid())
  tenantId       String
  couponId       String
  userId         String
  subscriptionId String   @unique
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  coupon       Coupon       @relation(fields: [couponId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@index([couponId, userId])
  @@map("plan_coupon_redemptions")
}

// ─── Refresh Token ───────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Per-tenant content & platform consent (§9) ──────────
// StaticPage: each tenant's own legal/footer content (Privacy Policy, Terms,
// Refund Policy, ...), written by that tenant's OWNER/STAFF, shown to that
// tenant's own customers. Distinct from PlatformTerms below, which is
// Arpit's own platform-level terms shown to tenant OWNERs.

model StaticPage {
  id          String   @id @default(uuid())
  tenantId    String
  slug        String
  title       String
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("static_pages")
}

// PlatformTerms: SUPER_ADMIN-authored, versioned. A tenant's OWNER must have
// a PlatformTermsAcceptance matching the latest version before their admin
// dashboard is usable (PlatformTermsGuard) — separate from TenantStatusGuard,
// this is a consent gate, not a payment gate.

model PlatformTerms {
  id          String   @id @default(uuid())
  version     Int      @unique
  content     String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("platform_terms")
}

model PlatformTermsAcceptance {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  version    Int
  acceptedAt DateTime @default(now())
  ipAddress  String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, version])
  @@index([tenantId])
  @@index([userId])
  @@map("platform_terms_acceptances")
}

// PlatformPage: Arpit's own platform's static content (About Us, Refund &
// Cancellation Policy, Contact, ...) — global, not tenant-scoped, since it
// describes the platform business itself rather than any one tenant's
// storefront. SUPER_ADMIN-authored, publicly readable. Distinct from
// StaticPage (per-tenant, that business's own content) and PlatformTerms
// (versioned, consent-tracked — this model is simple content, no acceptance
// tracking needed for an About/Refund page).

model PlatformPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  content     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_pages")
}

// ─── Platform billing (Phase 8) — Arpit's own SaaS subscription revenue,
// completely separate from any tenant's own PaymentSettings/commerce data.
// Uses Arpit's own Razorpay account (env-configured, never a tenant's own
// PaymentSettings row).

model PlatformSubscription {
  id                            String                     @id @default(uuid())
  tenantId                      String                     @unique
  // Nullable — a comped/custom one-off deal (SUPER_ADMIN typed a free-text
  // planCode/amount at invite-creation time instead of picking a catalog
  // row) has no PlatformPlan at all. When set, TenantLimits resolves its
  // effective order/subscriber caps from this plan's defaults unless a
  // per-tenant override is set.
  planId                        String?
  planCode                      String
  billingCycle                  BillingCycle
  amountInPaise                 Int
  status                        PlatformSubscriptionStatus @default(PENDING_PAYMENT)
  razorpaySubscriptionId        String?
  razorpayCustomerId            String?
  currentPeriodEnd              DateTime?
  // True once SUPER_ADMIN has scheduled a cancellation — the subscription
  // stays ACTIVE and keeps billing rights until currentPeriodEnd, then the
  // `subscription.cancelled` webhook flips status to CANCELLED. Resumable
  // (set back to false) any time before that webhook fires.
  cancelAtPeriodEnd             Boolean                    @default(false)
  // Self-serve plan switch (redesigned 2026-08-22 — Razorpay does not
  // reliably support an in-place plan_id update for any real payment
  // method, confirmed live against a card-paid subscription and cross-
  // checked against Razorpay's docs/Chargebee's integration notes; every
  // switch now goes through a fresh Checkout on a brand-new subscription).
  // An upgrade cancels the old subscription immediately and applies the
  // new one's planId/planCode/amountInPaise/razorpaySubscriptionId right
  // away, once its payment is verified. A downgrade authorizes the new
  // subscription now (deferred `start_at` = currentPeriodEnd) but keeps
  // billing on the OLD subscription/plan until it — recorded here,
  // pendingRazorpaySubscriptionId tracks the new one — and only commits
  // planId/planCode/amountInPaise/razorpaySubscriptionId once the OLD
  // subscription's `subscription.cancelled` webhook confirms its cycle
  // actually ended, never optimistically.
  scheduledPlanId               String?
  scheduledPlanChangeAt         DateTime?
  pendingRazorpaySubscriptionId String?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  plan          PlatformPlan?     @relation(fields: [planId], references: [id])
  scheduledPlan PlatformPlan?     @relation("ScheduledPlanChange", fields: [scheduledPlanId], references: [id])
  invoices      PlatformInvoice[]

  @@index([tenantId])
  @@index([planId])
  @@map("platform_subscriptions")
}

// The catalog of SaaS pricing tiers Arpit shows on his marketing site —
// deliberately separate from PlatformSubscription (which is per-tenant,
// billing-state-focused). defaultMax* are what a plan grants out of the
// box; TenantLimits.max*Override lets SUPER_ADMIN adjust a specific
// tenant's actual caps without changing which named tier they're on
// (confirmed 2026-08-02: "this is not fix, I can adjust from super admin").
model PlatformPlan {
  id                       String       @id @default(uuid())
  name                     String
  priceInPaise             Int
  billingCycle             BillingCycle
  defaultMaxOrdersPerMonth Int
  defaultMaxSubscribers    Int
  // Shown on the (separate, not-yet-built) public marketing site when true.
  isPublished              Boolean      @default(false)
  sortOrder                Int          @default(0)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  subscriptions             PlatformSubscription[]
  scheduledForSubscriptions PlatformSubscription[] @relation("ScheduledPlanChange")
  leads                     PlatformLead[]

  @@map("platform_plans")
}

// One row per tenant — usage caps + the counters/dedupe flags backing the
// near-limit nudge and blocked-attempt visibility. Deliberately NOT part of
// PlatformSubscription: signup-limiting in particular is an off-by-default
// defensive lever unrelated to plan tier (confirmed 2026-08-02), and a
// comped tenant with no PlatformSubscription at all can still have limits.
model TenantLimits {
  id       String @id @default(uuid())
  tenantId String @unique

  // Null = fall back to the tenant's PlatformSubscription.plan default; if
  // there's no plan either, the cap is unenforced (unlimited) — a brand-new
  // or comped tenant is never silently blocked by a feature they never knew
  // existed.
  maxOrdersOverride      Int?
  maxSubscribersOverride Int?

  // Monthly counters — "YYYY-MM" tags let a plain increment self-reset each
  // month without a cron job: a stale month tag is treated as zero.
  blockedOrderAttempts       Int     @default(0)
  blockedOrderAttemptsMonth  String?
  nearOrderLimitAlertedMonth String?
  orderLimitHitAlertedMonth  String?

  // Concurrent cap (not monthly) — reset explicitly whenever SUPER_ADMIN
  // raises the effective limit (see TenantLimitsService.updateLimits), the
  // natural "problem solved" signal for a cap that has no periodic reset.
  blockedSubscriberAttempts  Int     @default(0)
  nearSubscriberLimitAlerted Boolean @default(false)
  subscriberLimitHitAlerted  Boolean @default(false)

  // Signup limiting — off by default for every tenant, forever, until
  // SUPER_ADMIN explicitly flips it on for one (e.g. a spam/abuse spike),
  // then off again once resolved. Never plan-tier-based.
  signupLimitEnabled         Boolean @default(false)
  maxSignupsPerMonth         Int?
  blockedSignupAttempts      Int     @default(0)
  blockedSignupAttemptsMonth String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tenant_limits")
}

enum PlatformLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

// A cold "contact us" submission from the (separate, not-yet-built) public
// marketing site, OR a self-service "request a higher plan" ask from an
// already-active tenant's own OWNER — tenantId tells the two apart.
// Deliberately not an automated purchase: confirmed 2026-08-02, Arpit wants
// every platform-plan sale to go through a manual review + a real invite he
// sends himself, never an unattended signup-and-pay flow.
model PlatformLead {
  id           String             @id @default(uuid())
  businessName String
  contactEmail String
  contactPhone String?
  planId       String?
  message      String?
  tenantId     String?
  status       PlatformLeadStatus @default(NEW)
  createdAt    DateTime           @default(now())

  plan   PlatformPlan? @relation(fields: [planId], references: [id])
  tenant Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("platform_leads")
}

// Opaque, high-entropy token backing a public, unauthenticated activation
// link emailed to a prospective tenant — no login required to pay and
// activate. `razorpaySubscriptionId` is filled in lazily on first visit to
// the activation page (created once, reused on repeat visits/refreshes)
// rather than at invite-creation time, so an invite that's never opened
// never creates a stray Razorpay Subscription.
model TenantActivationInvite {
  id                     String       @id @default(uuid())
  tenantId               String
  token                  String       @unique
  planCode               String
  billingCycle           BillingCycle
  amountInPaise          Int
  razorpaySubscriptionId String?
  expiresAt              DateTime
  usedAt                 DateTime?
  createdByUserId        String
  createdAt              DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([token])
  @@map("tenant_activation_invites")
}

// One row per subscription charge attempt (success or failure), written
// from the `subscription.charged`/`subscription.pending` webhook
// handlers — backs the admin billing dashboard's per-tenant payment
// history. We never render our own platform invoice: `invoiceUrl` is
// Razorpay's own generated invoice link, just stored and linked to.
model PlatformInvoice {
  id                     String                @id @default(uuid())
  tenantId               String
  platformSubscriptionId String
  razorpayInvoiceId      String?
  // Unique (when set) so a webhook retry after a partial local failure
  // upserts the same row instead of creating a duplicate invoice + a
  // duplicate invoice/payment-failed email — Razorpay's own payment id is
  // the one stable identifier every real charge attempt has. Postgres
  // treats multiple NULLs as distinct under a unique constraint, so the
  // rare payment-less pending event (no payment attempt made yet) is
  // unaffected by this constraint.
  razorpayPaymentId      String?               @unique
  amountInPaise          Int
  status                 PlatformInvoiceStatus
  invoiceUrl             String?
  periodStart            DateTime?
  periodEnd              DateTime?
  createdAt              DateTime              @default(now())

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  platformSubscription PlatformSubscription @relation(fields: [platformSubscriptionId], references: [id])

  @@index([tenantId])
  @@index([platformSubscriptionId])
  @@map("platform_invoices")
}
