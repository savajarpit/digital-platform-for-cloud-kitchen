generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
  DELIVERY
  CUSTOMER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WhatsappProvider {
  INTERAKT
  AISENSY
  GUPSHUP
  TWILIO
}

enum EmailProvider {
  RESEND
  SMTP
}

// ─── Tenant ──────────────────────────────────────────────

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  plan         Plan     @default(FREE)
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                   User[]
  businessProfile         BusinessProfile?
  orderAcceptanceSettings OrderAcceptanceSettings?
  notificationSettings    NotificationSettings?
  paymentSettings         PaymentSettings?
  serviceablePincodes     ServiceablePincode[]
  rolePermissions         RolePermission[]
  categories              Category[]
  meals                   Meal[]

  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  passwordHash String
  firstName    String
  lastName     String?
  role         Role      @default(CUSTOMER)
  status       Status    @default(ACTIVE)
  tenantId     String
  isActive     Boolean   @default(true)
  verifiedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("users")
}

// ─── Business configuration (white-label, per tenant) ────

model BusinessProfile {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  displayName            String
  description            String?
  logoUrl                String?
  faviconUrl             String?
  heroImageUrl           String?
  supportEmail           String?
  supportPhone           String?
  whatsappBusinessNumber String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  country                String?
  pincode                String?
  timezone               String   @default("Asia/Kolkata")
  currency               String   @default("INR")
  gstNumber              String?
  themeConfig            Json     @default("{}")
  defaultLocale          String   @default("en")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("business_profiles")
}

model OrderAcceptanceSettings {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  operatingHours      Json     @default("{}")
  dailyCutoffTime     String?
  closedDates         Json     @default("[]")
  isTemporarilyClosed Boolean  @default(false)
  closureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("order_acceptance_settings")
}

model ServiceablePincode {
  id             String   @id @default(uuid())
  tenantId       String
  pincode        String
  deliveryFee    Int      @default(0)
  minOrderAmount Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, pincode])
  @@index([tenantId])
  @@map("serviceable_pincodes")
}

model NotificationSettings {
  id                      String            @id @default(uuid())
  tenantId                String            @unique
  whatsappEnabled         Boolean           @default(false)
  whatsappProvider        WhatsappProvider?
  whatsappApiKeyEncrypted String?
  whatsappConfigEncrypted Json?
  whatsappSenderNumber    String?
  ownerWhatsappNumber     String?
  emailEnabled            Boolean           @default(false)
  emailProvider           EmailProvider?
  emailFromAddress        String?
  emailFromName           String?
  emailConfigEncrypted    Json?
  ownerNotificationEmail  String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("notification_settings")
}

model PaymentSettings {
  id                             String   @id @default(uuid())
  tenantId                       String   @unique
  razorpayKeyId                  String?
  razorpayKeySecretEncrypted     String?
  razorpayWebhookSecretEncrypted String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("payment_settings")
}

// ─── Permissions (fine-grained, tenant-configurable RBAC) ─

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  category    String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  tenantId     String
  role         Role
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, role, permissionId])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("role_permissions")
}

// ─── Menu (Category + Meal) ──────────────────────────────

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  meals  Meal[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Meal {
  id                 String    @id @default(uuid())
  tenantId           String
  categoryId         String?
  name               String
  description        String?
  imageUrl           String?
  priceInPaise       Int
  nutrition          Json      @default("{}")
  isVegetarian       Boolean   @default(true)
  isAvailable        Boolean   @default(true)
  dailyQuantityLimit Int?
  sortOrder          Int       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isAvailable])
  @@index([deletedAt])
  @@map("meals")
}

// ─── Refresh Token ───────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
