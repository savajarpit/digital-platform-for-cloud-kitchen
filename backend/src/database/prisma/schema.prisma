generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
  DELIVERY
  CUSTOMER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WhatsappProvider {
  INTERAKT
  AISENSY
  GUPSHUP
  TWILIO
}

enum EmailProvider {
  RESEND
  SMTP
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationRecipientType {
  CUSTOMER
  OWNER
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── Tenant ──────────────────────────────────────────────

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  plan         Plan     @default(FREE)
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                   User[]
  businessProfile         BusinessProfile?
  orderAcceptanceSettings OrderAcceptanceSettings?
  notificationSettings    NotificationSettings?
  paymentSettings         PaymentSettings?
  serviceablePincodes     ServiceablePincode[]
  rolePermissions         RolePermission[]
  tenantFeatures          TenantFeature[]
  categories              Category[]
  meals                   Meal[]
  addresses               Address[]
  orders                  Order[]
  deliverySlots           DeliverySlot[]
  notificationLogs        NotificationLog[]

  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  passwordHash String
  firstName    String
  lastName     String?
  role         Role      @default(CUSTOMER)
  status       Status    @default(ACTIVE)
  tenantId     String
  isActive     Boolean   @default(true)
  verifiedAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  addresses     Address[]
  orders        Order[]

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("users")
}

// ─── Business configuration (white-label, per tenant) ────

model BusinessProfile {
  id                      String   @id @default(uuid())
  tenantId                String   @unique
  displayName             String
  description             String?
  logoUrl                 String?
  faviconUrl              String?
  heroImageUrl            String?
  supportEmail            String?
  supportPhone            String?
  whatsappBusinessNumber  String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  country                 String?
  pincode                 String?
  timezone                String   @default("Asia/Kolkata")
  currency                String   @default("INR")
  gstNumber               String?
  themeConfig             Json     @default("{}")
  defaultLocale           String   @default("en")
  // Geo-radius serviceability (Blinkit-style): when kitchenLat/kitchenLng and
  // deliveryRadiusMeters are all set, AddressesService prefers a real
  // distance-from-kitchen check over the ServiceablePincode table.
  kitchenLat              Float?
  kitchenLng              Float?
  deliveryRadiusMeters    Int?
  deliveryFee             Int?
  minOrderAmount          Int?
  freeDeliveryAboveAmount Int?
  // How many days ahead a customer may pick for delivery (0 = today only,
  // 2 = today/tomorrow/day-after). Checkout's day dropdown is bounded by
  // this, enforced again server-side in OrdersService.
  maxAdvanceOrderDays     Int      @default(2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("business_profiles")
}

model OrderAcceptanceSettings {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  operatingHours      Json     @default("{}")
  dailyCutoffTime     String?
  closedDates         Json     @default("[]")
  isTemporarilyClosed Boolean  @default(false)
  closureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("order_acceptance_settings")
}

model ServiceablePincode {
  id                      String   @id @default(uuid())
  tenantId                String
  pincode                 String
  deliveryFee             Int      @default(0)
  minOrderAmount          Int      @default(0)
  freeDeliveryAboveAmount Int?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, pincode])
  @@index([tenantId])
  @@map("serviceable_pincodes")
}

model DeliverySlot {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@index([tenantId])
  @@map("delivery_slots")
}

model NotificationSettings {
  id                      String            @id @default(uuid())
  tenantId                String            @unique
  whatsappEnabled         Boolean           @default(false)
  whatsappProvider        WhatsappProvider?
  whatsappApiKeyEncrypted String?
  whatsappConfigEncrypted Json?
  whatsappSenderNumber    String?
  ownerWhatsappNumber     String?
  emailEnabled            Boolean           @default(false)
  emailProvider           EmailProvider?
  emailFromAddress        String?
  emailFromName           String?
  emailConfigEncrypted    Json?
  ownerNotificationEmail  String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("notification_settings")
}

// Audit trail for every order-confirmation send attempt (one row per
// channel × recipient, whether it succeeded or failed) — debuggability and
// the natural place to check "did the customer actually get notified?".
model NotificationLog {
  id                String                    @id @default(uuid())
  tenantId          String
  orderId           String?
  channel           NotificationChannel
  recipientType     NotificationRecipientType
  recipient         String
  status            String
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime                  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@map("notification_logs")
}

model PaymentSettings {
  id                             String   @id @default(uuid())
  tenantId                       String   @unique
  razorpayKeyId                  String?
  razorpayKeySecretEncrypted     String?
  razorpayWebhookSecretEncrypted String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("payment_settings")
}

// ─── Permissions (fine-grained, tenant-configurable RBAC) ─

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  category    String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  tenantId     String
  role         Role
  permissionId String
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, role, permissionId])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("role_permissions")
}

// ─── Feature entitlement (tenant-level, separate from Permission) ─
// Permission (above) answers "can this role do X within a tenant that
// already has the feature?" Feature answers "does this tenant have access
// to X at all?" — SUPER_ADMIN-only, like a SaaS plan tier.

model Feature {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  tenantFeatures TenantFeature[]

  @@map("features")
}

model TenantFeature {
  id              String    @id @default(uuid())
  tenantId        String
  featureId       String
  enabled         Boolean   @default(false)
  enabledAt       DateTime?
  enabledByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([tenantId, featureId])
  @@index([tenantId])
  @@map("tenant_features")
}

// ─── Menu (Category + Meal) ──────────────────────────────

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  meals  Meal[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Meal {
  id                 String    @id @default(uuid())
  tenantId           String
  categoryId         String?
  name               String
  description        String?
  imageUrl           String?
  priceInPaise       Int
  nutrition          Json      @default("{}")
  isVegetarian       Boolean   @default(true)
  isAvailable        Boolean   @default(true)
  dailyQuantityLimit Int?
  sortOrder          Int       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isAvailable])
  @@index([deletedAt])
  @@map("meals")
}

// ─── Addresses & Commerce ─────────────────────────────────

model Address {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  label        String?
  contactPhone String
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  landmark     String?
  // Captured from the map picker at address-creation time; null for
  // addresses saved before that existed, or for tenants without the geo
  // serviceability mode configured. AddressesService falls back to pincode
  // matching whenever either is missing.
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("addresses")
}

model Order {
  id                  String        @id @default(uuid())
  tenantId            String
  userId              String
  addressId           String
  orderNumber         String
  status              OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus       PaymentStatus @default(PENDING)
  subtotalInPaise     Int
  deliveryFeeInPaise  Int           @default(0)
  totalInPaise        Int
  // The chosen calendar day, and a snapshot of the slot's name/window at
  // order time — snapshotted like OrderItem's price/name, so a tenant
  // editing DeliverySlot later never rewrites past order history.
  deliveryDate        DateTime
  deliverySlotId      String?
  deliverySlotName    String
  deliveryWindowStart String
  deliveryWindowEnd   String
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  address          Address           @relation(fields: [addressId], references: [id])
  deliverySlot     DeliverySlot?     @relation(fields: [deliverySlotId], references: [id])
  items            OrderItem[]
  notificationLogs NotificationLog[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  mealId               String?
  nameSnapshot         String
  priceInPaiseSnapshot Int
  quantity             Int
  createdAt            DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  meal  Meal? @relation(fields: [mealId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model RazorpayWebhookEvent {
  id           String    @id @default(uuid())
  eventId      String    @unique
  eventType    String
  status       String    @default("PENDING")
  errorMessage String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@map("razorpay_webhook_events")
}

// ─── Refresh Token ───────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
